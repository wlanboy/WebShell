# JDK- und JRE-Image mit demselben Tag, damit Build und Laufzeit dieselbe Temurin-Version haben.
ARG TEMURIN_TAG=25

FROM maven:3-eclipse-temurin-25 AS maven

FROM eclipse-temurin:${TEMURIN_TAG}-jdk AS build
COPY --from=maven /usr/share/maven /usr/share/maven
ENV MAVEN_HOME=/usr/share/maven PATH=/usr/share/maven/bin:$PATH
WORKDIR /build
COPY pom.xml .
RUN --mount=type=cache,target=/root/.m2 mvn -q dependency:go-offline
COPY src/main ./src/main
RUN --mount=type=cache,target=/root/.m2 \
    mvn -q -Dmaven.test.skip=true compile spring-boot:process-aot package

RUN JAR=$(ls target/*.jar | grep -v original) && \
    java -Djarmode=tools -jar "$JAR" extract --layers --application-filename app.jar --destination extracted
WORKDIR /app
RUN for layer in dependencies observability-dependencies spring-boot-loader snapshot-dependencies application-resources application; do \
      [ -d /build/extracted/$layer ] && cp -a /build/extracted/$layer/. /app/; \
    done

# Training im JRE-Image: Das JRE hat eine andere lib/modules als das JDK,
# ein im JDK erzeugter AOT-Cache wird zur Laufzeit verworfen.
FROM eclipse-temurin:${TEMURIN_TAG}-jre AS train
COPY --from=build /app /app
RUN java -XX:AOTCacheOutput=/app/app.aot \
         -XX:+UseSerialGC -XX:+UseCompactObjectHeaders \
         -Dspring.aot.enabled=true -Dspring.context.exit=onRefresh \
         -jar /app/app.jar

FROM eclipse-temurin:${TEMURIN_TAG}-jre
LABEL org.opencontainers.image.title="webshell" \
      org.opencontainers.image.description="Browser-based terminal frontend for executing shell commands" \
      org.opencontainers.image.version="0.1.2-SNAPSHOT" \
      org.opencontainers.image.vendor="wlanboy" \
      org.opencontainers.image.source="https://github.com/wlanboy/WebShell" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.base.name="docker.io/library/eclipse-temurin:25-jre"
USER 185:0
WORKDIR /app
COPY --from=build --chown=185:185 /build/extracted/dependencies/ ./
COPY --from=build --chown=185:185 /build/extracted/spring-boot-loader/ ./
COPY --from=build --chown=185:185 /build/extracted/snapshot-dependencies/ ./
COPY --from=build --chown=185:185 /build/extracted/application/ ./
COPY --from=train --chown=185:185 /app/app.aot ./app.aot
EXPOSE 8001
ENV JAVA_TOOL_OPTIONS="-Xms64m -Xmx192m -Xss512k \
  -XX:MaxMetaspaceSize=64m -XX:ReservedCodeCacheSize=48m -XX:TieredStopAtLevel=1 \
  -XX:ActiveProcessorCount=2 -XX:+ExitOnOutOfMemoryError -XX:-UsePerfData"
ENTRYPOINT ["java", \
  "-XX:AOTCache=/app/app.aot", \
  "-Dspring.aot.enabled=true", \
  "-XX:+UseSerialGC", \
  "-XX:+UseCompactObjectHeaders", \
  "-jar", "/app/app.jar"]
